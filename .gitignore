# Virtual environment (not committed)
.venv/
.venv-asr/

# Python cache
__pycache__/
*.pyc

# Large generated data (keep folders via .gitkeep)
models/**
!models/**/
!models/**/.gitkeep
# Generated datasets (created locally by extract_faces.py)
datasets/
# Synthetic demo output if written inside the project (see demo_data.py)
demo_data/
recordings/raw/**/*.mp4
recordings/processed/*
!recordings/processed/.gitkeep
checkpoints/*
!checkpoints/.gitkeep
logs/*
!logs/.gitkeep

# Local server logs (not project data)
api.log
*.log

# Local API token (created on first start; never commit)
config/api_token.txt

# Manual gesture annotations: personal labels for evaluation. Never commit them.
annotations/
