# Virtual environment (not committed)
.venv/

# Python cache
__pycache__/
*.pyc

# Large generated data (keep folders via .gitkeep)
models/**
!models/**/
!models/**/.gitkeep
# Generated datasets (created locally by extract_faces.py)
datasets/
